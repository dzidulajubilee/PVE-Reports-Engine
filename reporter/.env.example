# Reporter settings. Copy to .env (which git ignores) and edit there; install.sh does this for you.
# These are only starting values: once an admin saves Settings in the portal, out/settings.json takes over.

# Time zone until one is picked in Settings
TZ=UTC
# Name on reports and the portal (blank = "Reports")
REPORT_NAME=
# Report look: logbook, original, briefing, ledger, rack or pulse
REPORT_TEMPLATE=logbook

# Proxmox: node addresses (comma-separated), a read-only API token, and the nodes' certificate fingerprints
# (comma-separated, SHA-256). See docs/proxmox-setup.md
PVE_HOSTS=
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=
PVE_FINGERPRINT=
# Proxmox web address readers can open, for links in the PDFs, e.g. https://pve1.example.lan:8006
PVE_PUBLIC_URL=

# Which reports the scheduler sends, and the local hour it sends them
REPORTS=weekly,monthly,quarterly
SEND_HOUR=7
# the day weekly reports are made, 0 = Monday … 6 = Sunday; each covers the 7 days before it
WEEK_DAY=0

# Email: leave SMTP_HOST empty to only save PDFs
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_VERIFY=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# comma-separated recipients of the full report
REPORT_TO=
